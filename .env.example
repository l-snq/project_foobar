# club2k / project_foobar — environment variables
#
# Copy to .env.local for local dev:  cp .env.example .env.local
# .env.local is gitignored; .env.example is committed and must never hold real keys.
#
# Loaded by:
#   - Next.js       — automatically reads .env.local (dev + build)
#   - game server   — explicitly, via --env-file .env.local in package.json
#                     ("dev:server" and "start:server" scripts)
#
# Find these in the Supabase dashboard: Project Settings → API.

# --- Supabase: public (browser-visible) -------------------------------------
# NEXT_PUBLIC_ vars are inlined into the client bundle at build time. Never put
# a secret here. Both are also read by the server: server/db.ts uses the URL.
# Consumers: lib/supabase.ts, server/db.ts
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# --- Supabase: secret (server only) -----------------------------------------
# Service role key. Bypasses RLS on every table — this is full read/write access
# to the database and storage. Server-side only; never expose to the browser,
# never prefix with NEXT_PUBLIC_, never commit.
# Consumers: server/db.ts (adminSupabase), which backs every app/api/** route,
#            lib/storage.ts, and the WebSocket game server.
SUPABASE_SERVICE_KEY=<service_role secret key>

# --- Admin allowlist ---------------------------------------------------------
# Comma-separated auth user UUIDs permitted to manage the store catalogue.
# Two copies, deliberately: the server-side one is authoritative (it gates
# POST/DELETE /api/admin/store), the NEXT_PUBLIC_ one only decides whether the
# admin UI is rendered. Keep them in sync.
ADMIN_USER_IDS=<uuid>,<uuid>
NEXT_PUBLIC_ADMIN_USER_IDS=<uuid>,<uuid>
